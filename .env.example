# Blockchain Fraud Detection System - API Configuration
# 
# Copy this file to .env and add your actual API keys
# DO NOT commit .env file to git (it's in .gitignore)

# Etherscan API Key (for Ethereum wallet analysis)
# Get your free key at: https://etherscan.io/apis
# Free tier: 5 calls/second, 100,000 calls/day
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Helius API Key (for Solana pool analysis)
# Get your free key at: https://www.helius.dev/
# Free tier: 100 requests/day
HELIUS_API_KEY=your_helius_api_key_here

# Note: The Solana live API currently uses heuristic placeholders
# for liquidity event parsing. Synthetic test mode is recommended
# for Solana demonstrations until full DEX parsing is implemented.
